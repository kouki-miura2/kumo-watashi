{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "dev:node": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "check": "vp check",
    "test": "vp test",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "build:node": "vp build --ssr src/server.ts --outDir dist/node",
    "build": "wrangler deploy --dry-run --outdir dist/worker && vp build --ssr src/server.ts --outDir dist/node"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.23.14",
    "typescript": "catalog:",
    "wrangler": "^4.131.1"
  }
}
