# Copy to `.env` (gitignored) for `vp run backend#dev:node`.

# Required — create your own OAuth client at
# https://console.cloud.google.com/apis/credentials (OAuth client ID → Web application).
# Do not reuse someone else's; every deployer needs their own.
GOOGLE_CLIENT_ID=

# Optional — a random value keeps sessions alive across restarts. Falls back to a fresh random
# secret per run otherwise (sessions just reset each restart).
# SESSION_SECRET=

# Optional — defaults to 8787.
# PORT=
