{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kumo-watashi",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-11",
  // One origin: the frontend build is served as static assets at `/`, the API at `/api`.
  // `deploy` and `vp run -t backend-worker#build` build the frontend first.
  "assets": {
    "directory": "../frontend/dist",
    // Unknown paths fall back to index.html so vue-router's history mode works on reload.
    "not_found_handling": "single-page-application",
    // Without this, the SPA fallback would answer unknown `/api/*` paths with index.html.
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  // Not a secret in the "grants access" sense, but don't reuse the original author's — this repo
  // is OSS, and every deployer should authenticate against their own Google Cloud OAuth client
  // (Google Cloud Console → APIs & Services → Credentials → OAuth client ID → Web application),
  // not silently inherit someone else's. `SESSION_SECRET` is a real secret: set it via
  // `.dev.vars` (untracked) locally and `wrangler secret put SESSION_SECRET` in prod.
  //
  // TURNSTILE_SITE_KEY: create your own Turnstile widget (Cloudflare dashboard → Turnstile →
  // Add widget, or `wrangler turnstile widget create`), registered for this deployment's own
  // domain(s) — don't reuse the original author's, it won't work for a domain it wasn't
  // registered for anyway. Site key is public (docs/spec.md section 9). TURNSTILE_HOSTNAMES is
  // the same domain list, comma-separated, used to pin accepted siteverify responses.
  // TURNSTILE_SECRET_KEY is the widget's real secret: set it the same way as SESSION_SECRET.
  "vars": {
    "GOOGLE_CLIENT_ID": "<your-oauth-client-id>.apps.googleusercontent.com",
    "TURNSTILE_SITE_KEY": "<your-turnstile-site-key>",
    "TURNSTILE_HOSTNAMES": "<your-app-domain>",
  },
  // Transfer Session + file metadata (docs/spec.md section 23) — see src/dao/transfer.d1.ts.
  //
  // Copy this file to `wrangler.jsonc` (gitignored, since this repo is public) and fill in the
  // real database_name/database_id/bucket_name from `npx wrangler d1 create <name>` and
  // `npx wrangler r2 bucket create <name>` — see README.md's "First-time deploy setup".
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "<your-d1-database-name>",
      "database_id": "<your-d1-database-id>",
    },
  ],
  // File bodies (docs/spec.md section 22).
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "<your-r2-bucket-name>",
    },
  ],
}
