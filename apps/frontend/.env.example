# Copy to `.env` (gitignored) for `vp run frontend#dev` / `vp run frontend#build` (also run by
# `vp run backend-worker#deploy`). The API is called on the same origin (`/api`), so no URL here.

# Required — create your own OAuth client at
# https://console.cloud.google.com/apis/credentials (OAuth client ID → Web application), with
# this app's dev/prod origins added to "Authorized JavaScript origins". Do not reuse someone
# else's; every deployer needs their own.
VITE_GOOGLE_CLIENT_ID=

# Required — the Turnstile widget's site key (public, not secret — docs/spec.md section 9).
# Create your own widget (Cloudflare dashboard → Turnstile → Add widget, or
# `wrangler turnstile widget create`) registered for this deployment's own domain(s); it won't
# work with someone else's widget since Turnstile pins a widget to the domains it was created for.
# Must match `TURNSTILE_SITE_KEY` in apps/backend-worker/wrangler.jsonc — they're the public/secret
# halves of the same widget.
VITE_TURNSTILE_SITE_KEY=
